# quant-dashboard / Sentinel PMFX 環境變數範例
# 複製做 .env 再填值；全部係【可選】覆寫，冇設定就自動 fallback。
# 注意：本 repo 嘅 4 個分析 project 全部用 yfinance 免費源，冇任何必需 API key。

# ── 時區（建議設定）──
# 影響報告日期標記；預設系統時區
TZ=Asia/Hong_Kong

# ── 警報（可選：有設定才啟用對應通道）──
# 設定後 configs/config.yaml 的 alerts.telegram_enabled 會被強制為 true
TELEGRAM_BOT_TOKEN=
# 設定後 alerts.email_enabled 會被強制為 true
SMTP_HOST=

# ── 券商路由（可選）──
# 覆寫 configs/config.yaml 的 broker.provider / broker.endpoint
BROKER_PROVIDER=
BROKER_ENDPOINT=

# ── 備用資料源（可選但建議）──
# 缺失時：XAU/USD 現貨（Twelve Data 專用）會取不到資料，程式印警告後跳過該標的
TWELVEDATA_API_KEY=
